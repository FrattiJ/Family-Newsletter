# ---------------------------------------------------------------
# The one password your whole family shares to get into the site.
# Change this to something you're happy to text to relatives.
# ---------------------------------------------------------------
FAMILY_PASSWORD="change-me"

# A long random string used to sign login cookies. Keep it secret.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# The public address of your site. Used for links inside the emails.
SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------
# Sending the emails. These defaults are set up for a free Gmail
# account -- see README.md for how to get the app password.
# Leave SMTP_USER blank while testing and emails are written to
# .data/outbox instead of being sent to anybody.
# ---------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="For all my Peeps <you@gmail.com>"

# ---------------------------------------------------------------
# Storage. Leave these blank and everything is stored in .data/
# on your own computer. Fill them in to use Supabase (needed once
# the site is deployed, because hosts don't keep local files).
# ---------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
